# Copy to .env (or set these in your shell / azd environment) to configure the orchestrator.
# Every credential path is keyless: managed identity on Azure, your azd/az sign-in locally.

# Which sandbox backend to use: aca | docker | fake
SANDBOX_BACKEND=aca

# ── Azure Container Apps Sandboxes (SANDBOX_BACKEND=aca) ──────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
SANDBOX_GROUP_NAME=
SANDBOX_GROUP_REGION=
# The sandbox group's user-assigned identity (used for keyless ACR pulls of the engine image)
SANDBOX_GROUP_IDENTITY_RESOURCE_ID=
SANDBOX_GROUP_IDENTITY_CLIENT_ID=
# The engine image in ACR; prepare_images.py turns it into the primed and base disk images
REFEREE_ENGINE_IMAGE=
# Optional: pin specific disk images instead of discovering the newest by label
# REFEREE_PRIMED_DISK_IMAGE_ID=
# REFEREE_BASE_DISK_IMAGE_ID=
# Per-sandbox telemetry to Application Insights: auto | off
SANDBOX_TELEMETRY=auto
# Candidate sandbox size (L tier by default)
CANDIDATE_CPU=2000m
CANDIDATE_MEMORY=4096Mi

# ── Coding agent (Azure OpenAI / Microsoft Foundry), keyless ─────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Optional reasoning effort for the model, if it supports it
# LLM_REASONING_EFFORT=medium

# ── Observability ────────────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Local Docker backend (SANDBOX_BACKEND=docker) ────────────────────────────
LOCAL_ENGINE_IMAGE=referee-engine:local
LOCAL_PRIMED_IMAGE=referee-engine:primed

# ── Race behavior ────────────────────────────────────────────────────────────
MAX_PARALLEL_SANDBOXES=8
EGRESS_AUDIT_SECONDS=30
VERIFY_TIMEOUT_SECONDS=600
# The host the health probe tries, to prove a sandbox has no outbound network
EGRESS_PROBE_URL=https://example.com/
CES_TENANT=contoso
